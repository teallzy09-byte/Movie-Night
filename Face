import tkinter as tk

root = tk.Tk()
root.title("My App")
root.geometry("300x150") # Width x Height


def on_click():
    print("OK button was clicked!")
    root.destroy() # Closes the window


ok_button = tk.Button(root, text="OK", command=on_click, width=10)
# Add the button to the window with padding
ok_button.pack(pady=50)

root.mainloop()

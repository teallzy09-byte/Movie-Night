import streamlit as st

# Initialize the button text state if it doesn't exist
if "button_text" not in st.session_state:
    st.session_state.button_text = "OK"

# Define the function to update the text when clicked
def change_text():
    st.session_state.button_text = "Test Done"

# Create the button on the screen
st.button(st.session_state.button_text, on_click=change_text)
